{
  "version": 2,
  "framework": null,
  "installCommand": "echo 'No install needed'",
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/admin", "destination": "/", "permanent": false },
    { "source": "/admin.html", "destination": "/", "permanent": false },
    { "source": "/v2", "destination": "/", "permanent": false },
    { "source": "/v2/(.*)", "destination": "/$1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/map", "destination": "/index.html" },
    { "source": "/onboarding", "destination": "/index.html" },
    { "source": "/review", "destination": "/index.html" },
    { "source": "/mypage", "destination": "/index.html" },
    { "source": "/detail", "destination": "/index.html" },
    { "source": "/level-setup", "destination": "/index.html" },
    { "source": "/godmap", "destination": "/index.html" }
  ]
}
